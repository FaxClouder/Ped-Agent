# Answer model (OpenAI-compatible or Anthropic)
PED_AGENT_ANSWER__PROTOCOL=openai_compatible
PED_AGENT_ANSWER__MODEL=gpt-5-mini
PED_AGENT_ANSWER__API_KEY=
# PED_AGENT_ANSWER__BASE_URL=https://api.openai.com/v1
PED_AGENT_ANSWER__TEMPERATURE=0.1
PED_AGENT_ANSWER__MAX_TOKENS=4096
PED_AGENT_ANSWER__TIMEOUT_SECONDS=60
PED_AGENT_ANSWER__MAX_RETRIES=2

# Semantic verifier. "inherit" reuses the answer provider/model/client settings.
PED_AGENT_VERIFY__ENABLED=true
PED_AGENT_VERIFY__PROTOCOL=inherit
# PED_AGENT_VERIFY__MODEL=
# PED_AGENT_VERIFY__API_KEY=
# PED_AGENT_VERIFY__BASE_URL=

# Embeddings (OpenAI-compatible)
PED_AGENT_EMBEDDING__PROTOCOL=openai_compatible
PED_AGENT_EMBEDDING__MODEL=text-embedding-3-small
PED_AGENT_EMBEDDING__API_KEY=
# PED_AGENT_EMBEDDING__BASE_URL=https://api.openai.com/v1
# PED_AGENT_EMBEDDING__DIMENSIONS=1536
PED_AGENT_EMBEDDING__TIMEOUT_SECONDS=60
PED_AGENT_EMBEDDING__MAX_RETRIES=2

# External search. Semantic Scholar and OpenAlex do not require keys for the basic API.
PED_AGENT_SEARCH__ACADEMIC_ENABLED=true
PED_AGENT_SEARCH__PARALLEL_ENABLED=false
PED_AGENT_SEARCH__PARALLEL_API_KEY=
PED_AGENT_SEARCH__TIMEOUT_SECONDS=20
PED_AGENT_SEARCH__MAX_CANDIDATES_PER_SOURCE=5
PED_AGENT_SEARCH__MAX_PAGES=3

# Single-process local runtime
PED_AGENT_RUNTIME__HOST=127.0.0.1
PED_AGENT_RUNTIME__PORT=8000
PED_AGENT_RUNTIME__MAX_CONCURRENT_RUNS=2
PED_AGENT_RUNTIME__AGENT_DB_PATH=backend/storage/agent/agent.sqlite3
PED_AGENT_RUNTIME__CHROMA_PATH=backend/storage/agent/chroma
PED_AGENT_RUNTIME__RECENT_MESSAGE_LIMIT=6

# Optional LangSmith tracing. No trace is uploaded unless explicitly enabled.
PED_AGENT_LANGSMITH__ENABLED=false
PED_AGENT_LANGSMITH__API_KEY=
PED_AGENT_LANGSMITH__PROJECT=ped-agent
# PED_AGENT_LANGSMITH__ENDPOINT=

# One migration cycle of legacy key compatibility:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=
