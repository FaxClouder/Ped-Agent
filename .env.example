# Authoritative local configuration for the server and repository scripts.
# Copy this file to .env. Never commit the populated .env file.

# Answer model (OpenAI-compatible or Anthropic)
PED_AGENT_ANSWER__PROTOCOL=openai_compatible
PED_AGENT_ANSWER__MODEL=deepseek-v4-flash
PED_AGENT_ANSWER__API_KEY=
PED_AGENT_ANSWER__BASE_URL=https://api.deepseek.com
PED_AGENT_ANSWER__TEMPERATURE=0.1
PED_AGENT_ANSWER__MAX_TOKENS=4096
PED_AGENT_ANSWER__TIMEOUT_SECONDS=60
PED_AGENT_ANSWER__MAX_RETRIES=2
PED_AGENT_ANSWER__STRUCTURED_OUTPUT_METHOD=json_mode

# Semantic verifier. "inherit" reuses the answer provider/model/client settings.
PED_AGENT_VERIFY__ENABLED=true
PED_AGENT_VERIFY__PROTOCOL=inherit
PED_AGENT_VERIFY__MODEL=deepseek-v4-pro

# Embeddings (local BGE-M3 by default; CUDA is required unless CPU is explicit)
PED_AGENT_EMBEDDING__PROTOCOL=local_bge_m3
PED_AGENT_EMBEDDING__MODEL=BAAI/bge-m3
PED_AGENT_EMBEDDING__DIMENSIONS=1024
PED_AGENT_EMBEDDING__DEVICE=cuda
PED_AGENT_EMBEDDING__CACHE_DIR=backend/storage/models/embeddings
PED_AGENT_EMBEDDING__USE_FP16=true
PED_AGENT_EMBEDDING__NORMALIZE_EMBEDDINGS=true
PED_AGENT_EMBEDDING__BATCH_SIZE=16
# CPU fallback must be explicit:
# PED_AGENT_EMBEDDING__DEVICE=cpu
# PED_AGENT_EMBEDDING__USE_FP16=false
# Remote alternative:
# PED_AGENT_EMBEDDING__PROTOCOL=openai_compatible
# PED_AGENT_EMBEDDING__MODEL=text-embedding-3-small
# PED_AGENT_EMBEDDING__API_KEY=
# PED_AGENT_EMBEDDING__BASE_URL=https://api.openai.com/v1
# PED_AGENT_EMBEDDING__DIMENSIONS=1536
PED_AGENT_EMBEDDING__TIMEOUT_SECONDS=60
PED_AGENT_EMBEDDING__MAX_RETRIES=2

# Optional local Cross-Encoder rerank. Requires the root `rag` extra and model availability.
PED_AGENT_RERANK__ENABLED=false
PED_AGENT_RERANK__MODEL=BAAI/bge-reranker-v2-m3
PED_AGENT_RERANK__USE_FP16=true
PED_AGENT_RERANK__CACHE_SIZE=4096

# External search. Semantic Scholar and OpenAlex do not require keys for the basic API.
PED_AGENT_SEARCH__ACADEMIC_ENABLED=true
PED_AGENT_SEARCH__PARALLEL_ENABLED=false
PED_AGENT_SEARCH__PARALLEL_API_KEY=
PED_AGENT_SEARCH__TIMEOUT_SECONDS=20
PED_AGENT_SEARCH__MAX_CANDIDATES_PER_SOURCE=5
PED_AGENT_SEARCH__MAX_PAGES=3

# Single-process local runtime
PED_AGENT_RUNTIME__HOST=127.0.0.1
PED_AGENT_RUNTIME__PORT=8000
PED_AGENT_RUNTIME__MAX_CONCURRENT_RUNS=2
PED_AGENT_RUNTIME__AGENT_DB_PATH=memPed/conversations/conversations.sqlite3
PED_AGENT_RUNTIME__CHROMA_PATH=memPed/knowledge/vectors
PED_AGENT_RUNTIME__RECENT_MESSAGE_LIMIT=6

# Optional LangSmith tracing. No trace is uploaded unless explicitly enabled.
PED_AGENT_LANGSMITH__ENABLED=false
PED_AGENT_LANGSMITH__API_KEY=
PED_AGENT_LANGSMITH__PROJECT=ped-agent-local
PED_AGENT_LANGSMITH__SAMPLING_RATE=1.0
PED_AGENT_LANGSMITH__CONTENT_POLICY=redacted
# PED_AGENT_LANGSMITH__ENDPOINT=

# Shared local tooling
PED_AGENT_APP__LOG_LEVEL=INFO
PED_AGENT_VISION__BACKEND=yolo26_bytetrack
